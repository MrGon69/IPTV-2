# generate_m3u.py  –  chỉ lấy trận CÓ stream thật
#!/usr/bin/env python3
import json, urllib.request
from datetime import datetime, timezone, timedelta
from pathlib import Path

API_BASE = "https://khandai1.link"
API_MATCHES = f"{API_BASE}/api/matches/"
OUTPUT = Path("khandai1.m3u")
UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"
TZ = timezone(timedelta(hours=7))

def fetch(url: str) -> dict:
    req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "application/json"})
    with urllib.request.urlopen(req, timeout=15) as r:
        return json.loads(r.read().decode())

def abs_logo(p: str | None) -> str:
    if not p: return ""
    return p if p.startswith("http") else f"{API_BASE}{p}"

def format_time(iso: str) -> str:
    try:
        return datetime.fromisoformat(iso.replace("Z", "+00:00")).astimezone(TZ).strftime("%H:%M %d/%m")
    except: return ""

def build_extinf(m: dict) -> str:
    home = m.get("home_team_name") or "Home"
    away = m.get("away_team_name") or "Away"
    tour = m.get("tournament_name") or "Khác"
    t = format_time(m.get("start_time") or "")
    logo = abs_logo(m.get("home_team_logo") or m.get("away_team_logo"))
    title = f"🔴 LIVE [{t}] {home} vs {away}" if m.get("status") == "live" else f"[{t}] {home} vs {away}"
    return (f'#EXTINF:-1 tvg-id="{m.get("id")}" tvg-name="{title}" '
            f'tvg-logo="{logo}" group-title="Khandai|{tour}",{title}')

def collect() -> list:
    seen, out = set(), []
    for q in ["status=live&page_size=100", "is_hot=true&page_size=100", "page_size=100"]:
        try:
            data = fetch(f"{API_MATCHES}?{q}")
            for m in data.get("results", []):
                sid = m["id"]
                stream = (m.get("primary_stream_url") or m.get("backup_stream_url") or "").strip()
                if sid not in seen and stream and stream.startswith("http"):
                    seen.add(sid)
                    out.append(m)
        except Exception:
            continue
    out.sort(key=lambda x: x.get("start_time") or "")
    return out

def main():
    matches = collect()
    lines = ["#EXTM3U", f"# {datetime.now(TZ).isoformat()} | only matches with real stream"]
    for m in matches:
        stream = (m.get("primary_stream_url") or m.get("backup_stream_url")).strip()
        lines.append(build_extinf(m))
        lines.append(f"#EXTVLCOPT:http-user-agent={UA}")
        lines.append(f"#EXTVLCOPT:http-referrer={API_BASE}/")
        lines.append(stream)
    OUTPUT.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(f"Wrote {OUTPUT} → {len(matches)} channels (only live/stream available)")

if __name__ == "__main__":
    main()
