#!/usr/bin/env python3
"""
M3U generator with tvg-logo (team logos) for TiviMate / OTT Navigator / IPTV Smarters
Logo attribute = full absolute URL → app renders channel icon like screenshot
"""
import json, urllib.request

API = "https://khandai1.link/api/matches/?ordering=smart&page_size=100"
BASE = "https://khandai1.link"
req = urllib.request.Request(API, headers={"User-Agent": "Mozilla/5.0"})
with urllib.request.urlopen(req, timeout=12) as r:
    data = json.loads(r.read())

seen = set()
print("#EXTM3U")
for m in data.get("results", []):
    home = m.get("home_team_name", "")
    away = m.get("away_team_name", "")
    score = f"{m.get('home_score',0)}-{m.get('away_score',0)}"
    sport = m.get("sport_name", "Sport")
    status = m.get("status", "")
    logo_path = m.get("home_team_logo") or m.get("away_team_logo") or ""
    logo = (BASE + logo_path) if logo_path.startswith("/") else logo_path
    for c in m.get("commentators", []):
        url = c.get("stream_url") or c.get("backup_stream_url")
        if not url or "m3u8" not in url or url in seen:
            continue
        seen.add(url)
        name = c.get("name", "BLV")
        live = "Live" if (c.get("is_live") or status == "live") else "Scheduled"
        title = f"{name} | {home} {score} {away}"
        logo_attr = f' tvg-logo="{logo}"' if logo else ""
        print(f'#EXTINF:-1 tvg-id="{c.get("slug","")}" tvg-name="{title}"{logo_attr} group-title="{sport} {live}",{title}')
        print(url)
