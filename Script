#!/usr/bin/env python3
"""
Production-grade M3U generator for khandai1.link
Fetches live/scheduled matches via public API and emits valid M3U playlist.
"""

import json
import urllib.request
from datetime import datetime, timezone
from typing import List, Dict, Any

API_URL = "https://khandai1.link/api/matches/?ordering=smart&page_size=50"
HEADERS = {
    "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36",
    "Accept": "application/json",
}

def fetch_matches() -> List[Dict[str, Any]]:
    req = urllib.request.Request(API_URL, headers=HEADERS)
    with urllib.request.urlopen(req, timeout=15) as resp:
        data = json.loads(resp.read().decode())
    return data.get("results", [])

def build_m3u(matches: List[Dict[str, Any]]) -> str:
    lines = ["#EXTM3U"]
    for m in matches:
        status = m.get("status", "")
        sport = m.get("sport_name", "Sport")
        home = m.get("home_team_name", "Home")
        away = m.get("away_team_name", "Away")
        score = f"{m.get('home_score', 0)}-{m.get('away_score', 0)}"
        tournament = m.get("tournament_name", "")
        for c in m.get("commentators", []):
            stream = c.get("stream_url") or c.get("backup_stream_url")
            if not stream:
                continue
            name = c.get("name", "BLV")
            live_tag = "Live" if c.get("is_live") or status == "live" else "Scheduled"
            title = f"{name} | {home} {score} {away} ({tournament}) [{live_tag}]"
            group = f"{sport} {live_tag}"
            lines.append(
                f'#EXTINF:-1 tvg-id="{c.get("slug", "")}" '
                f'tvg-name="{title}" group-title="{group}",{title}'
            )
            lines.append(stream)
    return "\n".join(lines)

if __name__ == "__main__":
    matches = fetch_matches()
    playlist = build_m3u(matches)
    print(playlist)
    with open("khandai1.m3u", "w", encoding="utf-8") as f:
        f.write(playlist)
